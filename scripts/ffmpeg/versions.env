# Pinned sources for scripts/ffmpeg/build.sh. Sourced by bash; keep it KEY="value" only.
# Changing anything here changes the CI cache key and forces a rebuild on every target.
# Each archive is verified against its SHA-256 before it is unpacked.

# Shipped in every release (GPL): sources are attached to the release.
FFMPEG_VERSION="9.0.2"
FFMPEG_ARCHIVE="ffmpeg-9.0.2.tar.xz"
FFMPEG_URL="https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz"
FFMPEG_SHA256="8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e"

# x264 publishes no release tarballs; this is a snapshot of the `stable` branch.
X264_COMMIT="b35605ace3ddf7c1a5d67a2eb553f034aef41d55"
X264_ARCHIVE="x264-b35605ace3ddf7c1a5d67a2eb553f034aef41d55.tar.bz2"
X264_URL="https://code.videolan.org/videolan/x264/-/archive/b35605ace3ddf7c1a5d67a2eb553f034aef41d55/x264-b35605ace3ddf7c1a5d67a2eb553f034aef41d55.tar.bz2"
X264_SHA256="6eeb82934e69fd51e043bd8c5b0d152839638d1ce7aa4eea65a3fedcf83ff224"

X265_VERSION="4.2"
X265_ARCHIVE="x265_4.2.tar.gz"
X265_URL="https://download.videolan.org/pub/videolan/x265/x265_4.2.tar.gz"
X265_SHA256="40b1ea0453e0309f0eba934e0ddf533f8f6295966679e8894e8f1c1c8d5e1210"

# AV1 software decoder (BSD-2-Clause). FFmpeg's own AV1 decoder only drives hardware.
DAV1D_VERSION="1.5.4"
DAV1D_ARCHIVE="dav1d-1.5.4.tar.xz"
DAV1D_URL="https://downloads.videolan.org/pub/videolan/dav1d/1.5.4/dav1d-1.5.4.tar.xz"
DAV1D_SHA256="686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5"

# Windows and Linux only: NVIDIA decode headers (MIT), compiled into FFmpeg.
NVCODEC_VERSION="13.0.19.1"
NVCODEC_ARCHIVE="nv-codec-headers-n13.0.19.1.tar.gz"
NVCODEC_URL="https://github.com/FFmpeg/nv-codec-headers/archive/refs/tags/n13.0.19.1.tar.gz"
NVCODEC_SHA256="c293161bd92dac53f2f8fab08abcd4f96773c3644a57b23c2260b4be2311ab2f"

# Windows only: MSVC has no system zlib, and FFmpeg's PNG support needs it.
ZLIB_VERSION="1.3.2"
ZLIB_ARCHIVE="zlib-1.3.2.tar.gz"
ZLIB_URL="https://zlib.net/fossils/zlib-1.3.2.tar.gz"
ZLIB_SHA256="bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16"

# Host build tools only, never shipped.
PKGCONF_VERSION="3.0.7"
PKGCONF_ARCHIVE="pkgconf-3.0.7.tar.xz"
PKGCONF_URL="https://distfiles.ariadne.space/pkgconf/pkgconf-3.0.7.tar.xz"
PKGCONF_SHA256="c926ff491cbd9a331a589160811bd97ab1749b4d5198a519338f2cdfabe6940a"

NASM_VERSION="2.16.03"
NASM_ARCHIVE="nasm-2.16.03.tar.xz"
NASM_URL="https://www.nasm.us/pub/nasm/releasebuilds/2.16.03/nasm-2.16.03.tar.xz"
NASM_SHA256="1412a1c760bbd05db026b6c0d1657affd6631cd0a63cddb6f73cc6d4aa616148"

# meson and ninja build dav1d. meson runs from its unpacked source with python3; ninja
# is bootstrapped from source with its configure.py.
MESON_VERSION="1.12.1"
MESON_ARCHIVE="meson-1.12.1.tar.gz"
MESON_URL="https://github.com/mesonbuild/meson/releases/download/1.12.1/meson-1.12.1.tar.gz"
MESON_SHA256="ab0a6ca09f8ef70c564c8241fb5a23957886a0b53fb58412b5e07eaf07dba743"

