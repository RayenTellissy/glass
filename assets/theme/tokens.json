{
  "fonts": {
    "ui": { "family": "Geist", "paper": "--font-ui", "weights": [400, 500] },
    "mono": { "family": "Geist Mono", "paper": "--font-mono", "weights": [400] }
  },
  "font_weights": {
    "regular": { "value": 400, "paper": "--font-weight-regular" },
    "medium": { "value": 500, "paper": "--font-weight-medium", "note": "Heaviest weight in the app" }
  },
  "type": {
    "display": { "font": "ui", "weight": 500, "size_px": 24, "line_height_px": 32, "letter_spacing_em": -0.02, "paper": { "size": "--text-display", "line_height": "--leading-display", "tracking": "--tracking-display" }, "note": "First-run screens only, once per screen" },
    "title": { "font": "ui", "weight": 500, "size_px": 18, "line_height_px": 24, "letter_spacing_em": -0.01, "paper": { "size": "--text-title", "line_height": "--leading-title", "tracking": "--tracking-title" } },
    "body": { "font": "ui", "weight": 400, "size_px": 14, "line_height_px": 20, "letter_spacing_em": 0, "paper": { "size": "--text-body", "line_height": "--leading-body", "tracking": "--tracking-normal" }, "note": "Sheet / Tokens: 400 and 500" },
    "label": { "font": "ui", "weight": 400, "size_px": 12, "line_height_px": 16, "letter_spacing_em": 0, "paper": { "size": "--text-label", "line_height": "--leading-label", "tracking": "--tracking-normal" }, "note": "Sheet / Tokens: 400 and 500" },
    "caption": { "font": "ui", "weight": 400, "size_px": 11, "line_height_px": 14, "letter_spacing_em": 0, "caps_letter_spacing_em": 0.06, "paper": { "size": "--text-caption", "line_height": "--leading-caption", "tracking": "--tracking-normal", "caps_tracking": "--tracking-caps" }, "note": "Uppercase group labels use caps_letter_spacing_em" },
    "mono": { "font": "mono", "weight": 400, "size_px": 12, "line_height_px": 16, "letter_spacing_em": 0, "paper": { "size": "--text-mono", "line_height": "--leading-mono", "tracking": "--tracking-normal" }, "note": "Timecode and numeric fields" }
  },
  "spacing_px": {
    "2": { "value": 2, "paper": "--spacing-2" },
    "4": { "value": 4, "paper": "--spacing-4" },
    "8": { "value": 8, "paper": "--spacing-8", "note": "Pro gutter" },
    "12": { "value": 12, "paper": "--spacing-12" },
    "16": { "value": 16, "paper": "--spacing-16", "note": "Beginner gutter" },
    "24": { "value": 24, "paper": "--spacing-24" },
    "32": { "value": 32, "paper": "--spacing-32" },
    "48": { "value": 48, "paper": "--spacing-48", "board_only": true, "note": "Sheet and notes board margins only. Never inside app UI." },
    "64": { "value": 64, "paper": "--spacing-64", "board_only": true, "note": "Sheet and notes board margins only. Never inside app UI." }
  },
  "sizes_px": {
    "control_pro": { "value": 24, "paper": "--spacing-control-pro" },
    "control_beginner": { "value": 32, "paper": "--spacing-control-beginner" },
    "row_pro": { "value": 28, "paper": "--spacing-row-pro" },
    "row_beginner": { "value": 40, "paper": "--spacing-row-beginner" }
  },
  "radius_px": {
    "panel": { "value": 0, "paper": "--radius-panel", "note": "Docked panels, tracks, timeline" },
    "control": { "value": 4, "paper": "--radius-control", "note": "Buttons, inputs, clips" },
    "floating": { "value": 8, "paper": "--radius-floating", "note": "Popovers, dialogs, browser cards" },
    "pill": { "value": 999, "paper": "--radius-pill", "note": "Status chips, tags" }
  },
  "icon_px": {
    "sm": { "value": 16, "paper": "--spacing-icon-sm" },
    "md": { "value": 20, "paper": "--spacing-icon-md" }
  },
  "stroke_px": {
    "icon": { "value": 1.5, "paper": null, "source": "board text", "note": "Sheet / Tokens icon grid and Sheet / Icons: 1.5 px stroke, round caps and joins. Not a stored token." },
    "selected_clip_outline": { "value": 1.5, "paper": null, "source": "board text", "note": "Design brief: selected clips add a 1.5 px white (accent) outline. Not a stored token." }
  },
  "opacity": {
    "disabled": { "value": 0.4, "paper": "--opacity-disabled" },
    "glass": { "value": 0.72, "paper": "--opacity-glass", "note": "Glass fill over footage, with a 24 px backdrop blur" }
  },
  "breakpoints_px": {
    "min": { "value": 1280, "paper": "--breakpoint-min", "note": "Smallest supported window" },
    "default": { "value": 1920, "paper": "--breakpoint-default" }
  },
  "containers_px": {
    "inspector": { "value": 320, "paper": "--container-inspector" },
    "sheet": { "value": 1440, "paper": "--container-sheet" },
    "screen": { "value": 1920, "paper": "--container-screen" }
  },
  "rules": {
    "floating_shadow": { "offset_y_px": 16, "blur_px": 48, "color_token": "glass/shadow", "source": "board text", "note": "Translation table row 10 writes 0 16 48 at 50% black; the stored glass/shadow token is 60% black (dark) and 15% black (light). Use the token." },
    "focus_ring": { "width_px": 2, "gap_px": 2, "color_token": "accent", "source": "board text" },
    "backdrop_blur_px": { "value": 24, "source": "board text", "note": "Floating glass over footage" },
    "danger_fill_alpha": { "value": 0.14, "color_token": "state/error", "source": "board text", "note": "Danger button: state/error text on a 14% red fill" }
  }
}
